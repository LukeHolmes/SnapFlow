# Server
PORT=3001
DATA_DIR=.

# Development uses SQLite by default.
DB_PATH=./snapflow-backend.db
# DATABASE_URL=postgres://snapflow:snapflow@localhost:5432/snapflow

# GxP evidence migrations/tests (CI/local Postgres only — not the hosted Supabase URL)
# EVIDENCE_DATABASE_URL=postgres://snapflow:snapflow@127.0.0.1:5432/snapflow_evidence_test
# SUPABASE_PROJECT_REF=nrkgzsrgqnhbiamknjws
# SUPABASE_URL=https://nrkgzsrgqnhbiamknjws.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# GxP evidence BFF (service role only — never commit real values)
# EVIDENCE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://nrkgzsrgqnhbiamknjws.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EVIDENCE_BUCKET=evidence
# EVIDENCE_SIGNED_URL_TTL_SEC=900

# Auth and vault
# Dev-only default; production requires AUTH_SECRET ≥32 chars (see validateConfig).
AUTH_SECRET=dev-insecure-secret-change-me
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_MS=2592000000
# HMAC for public capture share links (must differ from AUTH_SECRET in production).
# SHARE_LINK_SECRET=
# 32-byte hex key; generate with: openssl rand -hex 32
# VAULT_KEY=
# Local dev/tests: set DEV_LOGIN=true to enable POST /auth/token (defaults to false).
DEV_LOGIN=true
# Billing webhook HMAC (Stripe-style Snapflow-Signature header). Required in production.
# BILLING_WEBHOOK_SECRET=

# Public URL for signed capture image links (Notion/GitHub/Jira). Defaults to OAUTH_REDIRECT_BASE.
# PUBLIC_BASE_URL=https://api.snapflow.example

# Signed capture URL lifetime (milliseconds). Default: 86400000 (24 hours).
# SIGNED_URL_TTL_MS=86400000

# Blob storage driver: local (disk under DATA_DIR/blobs) or s3 (R2, MinIO, Supabase S3 API, etc.)
# BLOB_STORAGE_DRIVER=local

# --- S3-compatible object storage (free tiers: Cloudflare R2, Supabase Storage S3) ---
# BLOB_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=snapflow-captures
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# AI proxy
# ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-latest
AI_RATE_PER_MIN=30

# OAuth redirect (backend callback URLs for all providers)
OAUTH_REDIRECT_BASE=http://localhost:3001

# Desktop deep link after OAuth (must match Electron protocol handler)
# APP_REDIRECT_URL=snapflow://oauth/callback

# --- Destination OAuth apps (free tiers; register in each provider console) ---
# Callback pattern for every provider:
#   {OAUTH_REDIRECT_BASE}/auth/oauth/<provider>/callback
# <provider> is: slack | notion | google (Gmail) | github | jira

# Slack app — https://api.slack.com/apps
# Bot scopes: files:write, channels:read, groups:read
# Redirect: http://localhost:3001/auth/oauth/slack/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
SLACK_API_BASE=https://slack.com/api

# Notion integration — https://www.notion.so/my-integrations
# Redirect: http://localhost:3001/auth/oauth/notion/callback
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
NOTION_API_BASE=https://api.notion.com

# Google Cloud project (Gmail send only) — https://console.cloud.google.com
# OAuth client (Web). Scope: https://www.googleapis.com/auth/gmail.send
# Redirect: http://localhost:3001/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GMAIL_API_BASE=https://gmail.googleapis.com

# GitHub OAuth app — https://github.com/settings/developers
# Scopes: repo (or public_repo for public repos only)
# Redirect: http://localhost:3001/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_API_BASE=https://api.github.com

# Atlassian developer console — https://developer.atlassian.com/console/myapps/
# OAuth 2.0 (3LO). Scopes: read:jira-user read:jira-work write:jira-work offline_access
# Redirect: http://localhost:3001/auth/oauth/jira/callback
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
JIRA_AUTH_BASE=https://auth.atlassian.com
JIRA_API_BASE=https://api.atlassian.com
