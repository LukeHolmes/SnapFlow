# Server
PORT=3001
DATA_DIR=.

# Development uses SQLite by default.
DB_PATH=./snapflow-backend.db
# DATABASE_URL=postgres://snapflow:snapflow@localhost:5432/snapflow

# Auth and vault
AUTH_SECRET=dev-insecure-secret-change-me
# 32-byte hex key; generate with: openssl rand -hex 32
# VAULT_KEY=
DEV_LOGIN=true

# AI proxy
# ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-latest
AI_RATE_PER_MIN=30

# Delivery/OAuth
SLACK_API_BASE=https://slack.com/api
OAUTH_REDIRECT_BASE=http://localhost:3001
# APP_REDIRECT_URL=snapflow://auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
