{
  "name": "snapflow",
  "version": "1.1.0",
  "description": "SnapFlow — smart screen capture. Capture → Context → Deliver.",
  "author": "Luke Holmes",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run rebuild:electron",
    "dev": "electron-vite dev",
    "web:dev": "VITE_ALLOW_WEB_MOCK=true vite --host 0.0.0.0 src/renderer",
    "web:build": "vite build src/renderer",
    "web:build:pages": "VITE_BASE=/SnapFlow/ vite build src/renderer",
    "web:preview": "vite preview --host 0.0.0.0 src/renderer",
    "build": "electron-vite build",
    "prepreview": "npm run rebuild:electron",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run rebuild:node",
    "test": "node --test --import tsx \"./tests/**/*.test.ts\"",
    "rebuild": "npm run rebuild:electron",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "predist": "npm run rebuild:electron && npm run licenses:bundle",
    "dist": "electron-vite build && electron-builder",
    "licenses:bundle": "node scripts/generate-third-party-licenses.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "better-sqlite3": "^13.0.3",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.383.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "overrides": {
    "tar": "7.5.23"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^42.11.18",
    "electron-builder": "^26.15.3",
    "license-checker": "^25.0.1",
    "electron-vite": "^6.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "app.snapflow.desktop",
    "productName": "SnapFlow",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      { "from": "resources/tesseract", "to": "tesseract" },
      { "from": "resources/third-party-licenses.txt", "to": "third-party-licenses.txt" },
      { "from": "LICENSE", "to": "legal/LICENSE" },
      { "from": "docs/PRIVACY.md", "to": "legal/PRIVACY.md" },
      { "from": "docs/EULA.md", "to": "legal/EULA.md" }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LukeHolmes",
        "repo": "SnapFlow"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "SnapFlow captures screen content for screenshots; audio is not recorded."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "maintainer": "SnapFlow <hello@snapflow.app>",
      "executableName": "snapflow"
    },
    "win": {
      "target": "nsis",
      "publish": ["github"]
    }
  }
}
