# Desktop runtime
# free | pro | team | perpetual
SNAPFLOW_TIER=pro
SNAPFLOW_WORKSPACE=ws_local

# Optional backend connection for AI tagging, cloud sync, and server-side delivery.
SNAPFLOW_AI_PROXY_URL=http://localhost:3001
# SNAPFLOW_CLOUD_URL=http://localhost:3001
# SNAPFLOW_API_TOKEN=<token from backend POST /auth/token>
#
# Cloud sync is opt-in in the desktop app (Account → Cloud sync). Metadata can sync in the
# background; image blobs upload when you send to Notion/GitHub/Jira or tap Sync now.
#
# After backend OAuth apps are configured (see docs/DESTINATION_SETUP.md), set on the backend:
# APP_REDIRECT_URL=snapflow://oauth/callback
